{
  "id": "epsilon-change",
  "name": "Epsilon Change",
  "version": "0.1.0",
  "assetVersion": "2026-08-19-overview-navigation-v18",
  "description": "Fold-adjusted post-1990 annual-median epsilon effects with an All / Low / High flow selector.",
  "author": "Spatial Research Team",
  "icon": "activity",
  "entry": "./index.js",
  "className": "EpsilonChangeModule",
  "importKind": "module-manifest",
  "defaultLoad": true,
  "analysisView": "change",
  "defaultRegime": "all",
  "skillFilterMetric": "nse",
  "skillFilterThreshold": 0.5,
  "globalStoryFile": "./data/global-story-summary.json",
  "datasets": [
    {
      "id": "epsilon-catchment-distributions",
      "file": "./data/epsilon-catchment-distributions.json"
    }
  ],
  "provides": {
    "layers": [
      {
        "id": "epsilon-catchments",
        "name": "Catchment epsilon change",
        "type": "vector",
        "interactive": true
      }
    ],
    "panels": [
      {
        "id": "epsilon-catchment-inspector",
        "name": "Epsilon catchment inspector",
        "position": "right",
        "trigger": "feature:click",
        "condition": { "layer": "epsilon-catchments", "module": "epsilon-change" }
      }
    ],
    "dataProducts": [
      {
        "id": "epsilon-distribution-statistics",
        "type": "cross-fitted-inference-summary",
        "description": "Per-catchment out-of-time pre/post epsilon CDF and summary statistics under all-, low-, and high-flow regimes."
      }
    ]
  }
}
